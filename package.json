{
  "name": "sca-triage",
  "version": "1.2.4",
  "description": "npm SCA scanner: rank dependency vulnerabilities by whether your code loads them, apply the smallest safe upgrades, and prove them with your project's tests.",
  "license": "MIT",
  "author": "Robin Lansiquot",
  "homepage": "https://github.com/lansiquo/sca-triage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lansiquo/sca-triage.git"
  },
  "bugs": {
    "url": "https://github.com/lansiquo/sca-triage/issues"
  },
  "type": "module",
  "bin": {
    "sca-triage": "bin/sca-triage.js"
  },
  "files": [
    "bin",
    "src",
    "SECURITY.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "sca",
    "security",
    "npm",
    "vulnerability",
    "reachability",
    "supply-chain",
    "triage",
    "github-action",
    "sbom",
    "cyclonedx"
  ]
}
